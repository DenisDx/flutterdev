# UID/GID пользователя dev внутри контейнера (id -u denis / id -g denis).
DEV_UID=1000
DEV_GID=1000

# Адрес и порты Flutter Web dev-сервера.
WEB_BIND_ADDRESS=<HOST_LAN_IP_OR_LOOPBACK>
WEB_HOST_PORT=28080
WEB_CONTAINER_PORT=8080

# Адрес и порты SSH-сервера контейнера.
SSH_BIND_ADDRESS=<HOST_LAN_IP_OR_LOOPBACK>
SSH_HOST_PORT=20022
SSH_CONTAINER_PORT=22

# Общая внешняя Docker-сеть для flutterdev и browser-контейнера.
DOCKER_NETWORK=flutterdev-net

# GID устройства /dev/kvm на хосте (stat -c %g /dev/kvm).
KVM_GID=<HOST_KVM_DEVICE_GID>

# Полные проверенные MCP endpoint'ы (суффикс /mcp не добавляется автоматически).
SEARXNG_MCP_URL=<FULL_SEARXNG_MCP_ENDPOINT>
PLAYWRIGHT_MCP_URL=<FULL_PLAYWRIGHT_MCP_ENDPOINT>

# OpenAI-совместимый сервер инференса.
LOCAL_LLM_BASE_URL=<INFERENCE_ENDPOINT>
LOCAL_LLM_MODEL=<MODEL_NAME>

# Секреты. Не коммитить реальный .env.
LOCAL_LLM_API_KEY=
OPENCODE_GO_API_KEY=
DEEPSEEK_API_KEY=

# Принятие лицензий Android SDK при сборке образа.
# true означает осознанное согласие с условиями Android SDK.
ANDROID_ACCEPT_LICENSES=false
