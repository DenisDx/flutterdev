# UID/GID of the dev user inside the container (run: id -u / id -g).
DEV_UID=<HOST_UID>
DEV_GID=<HOST_GID>

# Address and ports of the Flutter Web dev server.
WEB_BIND_ADDRESS=<HOST_LAN_IP_OR_LOOPBACK>
WEB_HOST_PORT=<WEB_HOST_PORT>
WEB_CONTAINER_PORT=<WEB_CONTAINER_PORT>

# Address and ports of the container SSH server.
SSH_BIND_ADDRESS=<HOST_LAN_IP_OR_LOOPBACK>
SSH_HOST_PORT=<SSH_HOST_PORT>
SSH_CONTAINER_PORT=<SSH_CONTAINER_PORT>

# Shared external Docker network for flutterdev and the browser container.
DOCKER_NETWORK=<DOCKER_NETWORK_NAME>

# GID of the host /dev/kvm device (stat -c %g /dev/kvm).
KVM_GID=<HOST_KVM_DEVICE_GID>

# Full verified MCP endpoints (the /mcp suffix is not appended automatically).
SEARXNG_MCP_URL=<FULL_SEARXNG_MCP_ENDPOINT>
PLAYWRIGHT_MCP_URL=<FULL_PLAYWRIGHT_MCP_ENDPOINT>

# OpenAI-compatible inference server.
LOCAL_LLM_BASE_URL=<INFERENCE_ENDPOINT>
LOCAL_LLM_MODEL=<MODEL_NAME>

# Secrets. Do not commit the real .env.
LOCAL_LLM_API_KEY=
OPENCODE_GO_BASE_URL=<OPENCODE_GO_BASE_URL>
OPENCODE_GO_API_KEY=<OPENCODE_GO_API_KEY>
DEEPSEEK_API_KEY=

# Android AVD name used by the container.
ANDROID_AVD_NAME=<ANDROID_AVD_NAME>

# Acceptance of Android SDK licenses during the image build.
# true means explicit consent to the Android SDK terms.
ANDROID_ACCEPT_LICENSES=false
