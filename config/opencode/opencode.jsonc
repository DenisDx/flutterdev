{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["/workspace/AGENTS.md"],

  // Default model: OpenAI-compatible local inference server.
  "model": "local-llm/local-model",
  "small_model": "local-llm/local-model",
  "autoupdate": false,

  "provider": {
    "local-llm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local inference",
      "options": {
        "baseURL": "{env:LOCAL_LLM_BASE_URL}",
        "apiKey": "{env:LOCAL_LLM_API_KEY}"
      },
      "models": {
        "local-model": {
          "id": "{env:LOCAL_LLM_MODEL}",
          "name": "Local model ({env:LOCAL_LLM_MODEL})",
          "limit": {
            "context": 164000,
            "output": 16384
          }
        }
      }
    },
    "opencode-go": {
      "options": {
        "baseURL": "{env:OPENCODE_GO_BASE_URL}",
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      }
    }
  },

  // DeepSeek uses the built-in provider and the DEEPSEEK_API_KEY variable
  // passed into the Compose container.

  "mcp": {
    "dart": {
      "type": "local",
      "command": ["dart", "mcp-server"],
      "enabled": true
    },
    "searxng": {
      "type": "remote",
      "url": "{env:SEARXNG_MCP_URL}",
      "enabled": true,
      "oauth": false
    },
    "playwright": {
      "type": "remote",
      "url": "{env:PLAYWRIGHT_MCP_URL}",
      "enabled": true,
      "oauth": false
    }
  },

  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  }
}
