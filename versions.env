# Политики версий. Слова stable/lts разрешаются сборочными скриптами
# в актуальные версии на момент сборки.
BASE_IMAGE=ubuntu:26.04
FLUTTER_CHANNEL=stable
OPENCODE_CHANNEL=stable
NODE_CHANNEL=lts

# Политика Android. Значения выбираются по совместимости с проектами,
# а не механически как максимальные доступные.
ANDROID_API_LEVEL=36
ANDROID_BUILD_TOOLS=36.0.0
ANDROID_SYSTEM_IMAGE="system-images;android-36;google_apis;x86_64"
ANDROID_AVD_NAME=flutterdev_api36
JDK_PACKAGE=openjdk-21-jdk
