# Version policies. The stable/lts keywords are resolved by the build scripts
# to current versions at build time.
BASE_IMAGE=ubuntu:26.04
FLUTTER_CHANNEL=stable
OPENCODE_CHANNEL=stable
NODE_CHANNEL=lts

# Android policy. Values are chosen for compatibility with the projects,
# not mechanically as the highest available versions.
ANDROID_API_LEVEL=36
ANDROID_BUILD_TOOLS=36.0.0
ANDROID_SYSTEM_IMAGE="system-images;android-36;google_apis;x86_64"
JDK_PACKAGE=openjdk-21-jdk
